# .env.example — Northgate Dental Live Build Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# The concept/demo version does NOT require any of these variables.
# These are ONLY needed when building the live, integrated production version.
#
# NEVER commit your real .env file to version control.
# =============================================================================

# ─── PRACTICE DIARY / PMS INTEGRATION ───────────────────────────────────────
# Supported providers: "dentally" | "software-of-excellence"
PMS_PROVIDER=dentally
PMS_API_KEY=your_pms_api_key_here
PMS_PRACTICE_ID=your_practice_id_here
PMS_API_BASE_URL=https://api.dentally.co/v1

# ─── SMS CONFIRMATIONS (Twilio) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+44xxxxxxxxxx
# Confirmation SMS template — {ref} is replaced with the NGD-XXXXX reference
TWILIO_CONFIRM_TEMPLATE=Your Northgate Dental appointment request {ref} is confirmed. We will be in touch shortly to finalise your slot.
# Reminder SMS sent 24h before appointment
TWILIO_REMINDER_TEMPLATE=Reminder: your appointment at Northgate Dental is tomorrow. Reply HELP if you need to reschedule. Ref: {ref}

# ─── GOOGLE REVIEWS (replace sample testimonials in live build) ──────────────
GOOGLE_PLACES_API_KEY=your_places_api_key_here
GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxx
# Minimum star rating to display (e.g. 4 = show 4-star and 5-star reviews only)
GOOGLE_MIN_RATING=4

# ─── ANALYTICS (GA4) ─────────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Events tracked: form_start | form_submit | confirmation_shown | cta_click | phone_click

# ─── API CONFIGURATION (Serverless functions / Backend) ──────────────────────
API_BASE_URL=https://api.northgatedental.co.uk/v1
CORS_ALLOWED_ORIGINS=https://northgatedental.co.uk,https://www.northgatedental.co.uk
API_RATE_LIMIT_PER_HOUR=60
# Booking reference prefix — matches the demo (NGD-XXXXX)
REFERENCE_PREFIX=NGD

# ─── SPAM / BOT PROTECTION (required for live build) ─────────────────────────
# Cloudflare Turnstile (or swap for hCaptcha)
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Honeypot field name (keep it generic to fool bots)
HONEYPOT_FIELD_NAME=website_url

# ─── EMAIL NOTIFICATIONS (Practice admin) ────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@northgatedental.co.uk
SMTP_PASS=your_smtp_password_here
ADMIN_EMAIL=reception@northgatedental.co.uk
ADMIN_EMAIL_SUBJECT_PREFIX=[Northgate Dental] New appointment request

# ─── SESSION / SECURITY ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here_generate_a_real_one
CSRF_SECRET=your_csrf_secret_here_generate_a_real_one
NODE_ENV=production
